# The real environment file holds a database password and the session-signing secret.
.env
nodemodules/
# Runtime state: the credential key ring, the SQLite demo database and the evidence
# directory. Everything under var/ holds either a key or a frame, so none of it belongs
# in an export. The scratch files already there (var/*.key hold real key material, and
# var/offline_ddl.sql) can be regenerated with `alembic upgrade head --sql`.
var/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
