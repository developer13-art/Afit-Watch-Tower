# Tracked defaults for `vite dev` (mode "development"). Loaded after .env, before .env.development.local.
#
# Nothing in this file supplies an API host. src/config/apiUrl.ts has no default endpoint either,
# so a dev session with no machine-local configuration has no server to talk to and says so on the
# login screen rather than guessing. Put this machine's cloud API address in .env.development.local.

VITE_APP_ENV=development

# A fresh clone walks the UI on fixtures with no backend running. A machine that has the cloud API
# up overrides this with VITE_USE_FIXTURES=0 in .env.development.local. Fixtures need Vite DEV mode
# as well as this flag, and never survive into `vite build` - verify:fixtures proves it.
VITE_USE_FIXTURES=1
