# AFIT WATCH TOWER - personnel app configuration template.
#
# This file is a reference, not something to copy wholesale. Vite picks the file by mode, and the
# modes must stay separate - a value in the wrong file is compiled into the wrong build:
#
#   .env.development       tracked   dev defaults (fixtures on, no API host)
#   .env.production        tracked   release defaults (fixtures off, no API host - see below)
#   .env.development.local gitignore THIS machine's dev endpoint (may be a loopback address)
#   .env.production.local  gitignore the deployed HTTPS endpoint for a release build
#
# There is no plain `.env` and `.env.local` is not used here on purpose: Vite reads `.env.local` in
# EVERY mode including `vite build`, so a development address written there ships inside the APK.
# Machine-specific values belong in the mode-qualified `.local` files.
#
# HARD RULES
#   1. Everything in these files is compiled INTO the JavaScript bundle and is readable by anyone
#      who has the APK or the site. There is no such thing as a secret here.
#   2. Never put here: the Neon connection string, any database username or password, any
#      administrative database credential, the Firebase *service account* (that file belongs to
#      the cloud host, named by CLOUD_FIREBASE_SERVICE_ACCOUNT_FILE), the FCM server key, or any
#      camera password or RTSP URL. The app talks to the cloud API with a bearer token and never
#      to a database or a camera.
#   3. The VITE_FIREBASE_* values below are the *public* web client config Firebase prints for an
#      app. They are safe to publish and are not what authorises a push send.
#   4. `android/app/google-services.json` is also client-side, but it is generated per project:
#      keep it out of version control if your Firebase project is private, and never edit its
#      values by hand - they must match the app id below.

# ---------------------------------------------------------------- API endpoint

# The deployed cloud service, and nothing else. In a release build this is HTTPS with a valid
# certificate on a host the phone can resolve over its own network. A loopback address, a private
# LAN address and plain HTTP are all rejected: src/config/apiUrl.ts marks the build as unsafe and
# the login screen refuses to send a password to it.
#
# There is NO default host. Leaving both keys empty produces a build that says "No server
# configured" and will not sign anyone in - which is honest, and is what an un-deployed backend
# should produce. Do not put a guessed address in to make the screen go quiet.
#
#   VITE_API_URL=https://watchtower.example.afit.edu.ng/api/v1   (full base; wins if set)
#   VITE_API_BASE_URL=https://watchtower.example.afit.edu.ng     (origin; /api/v1 is appended)
VITE_API_URL=
VITE_API_BASE_URL=

# Shown in the profile screen and used to decide whether to warn about an insecure host.
VITE_APP_ENV=development


# ---------------------------------------------------------------- Android identity

# Must equal `appId` in capacitor.config.ts and `applicationId` in android/app/build.gradle, and
# must equal the `package_name` inside android/app/google-services.json. A mismatch produces a
# token that registers cleanly and is undeliverable, because the cloud pages the Firebase project
# the token belongs to.
VITE_ANDROID_APP_ID=com.afit.watchtower.personnel

# ---------------------------------------------------------------- Request budgets

# A call that has not answered in this many milliseconds is treated as a network failure and the
# screen offers a retry, so a captive-portal redirect cannot hold an officer's queue open forever.
VITE_API_TIMEOUT_MS=12000
VITE_AUTH_TIMEOUT_MS=15000

# ---------------------------------------------------------------- Alert refresh cadence

# While the app is open, the dashboard, the alert centre and the incident history re-read
# themselves every this many seconds. Without a Firebase project this is the only way an alert
# reaches a handset, so set it as low as your data plan allows — but it is a pull, not a push:
# a closed app runs nothing and an alert waits for the next time the phone is opened.
# 0 disables it, leaving the manual Refresh button as the only way to see a new alert.
VITE_ALERT_POLL_SECONDS=20

# ---------------------------------------------------------------- Live updates

# The app holds one authenticated Server-Sent-Events connection per signed-in session
# (GET <api>/events/stream, contract 10.8) so an alert that lands is on the screen in about two
# seconds instead of up to VITE_ALERT_POLL_SECONDS. Set to 0 to close the channel and use the poll
# alone; the app then shows "This service does not offer live updates" and nothing else changes.
# It is a latency accelerator, NOT delivery to a closed app - only Firebase push reaches a phone
# that is not running, and no configuration here changes that.
VITE_LIVE_FEED=1

# Only set this when the stream is not simply <VITE_API_URL>/events/stream - a reverse proxy that
# puts the live channel on its own host, for example. The app derives the URL from the API base
# when this is empty, and never puts a token in either: the credential travels in the
# Authorization header, because a query string is written into every access log between here
# and the service.
VITE_LIVE_FEED_URL=

# ---------------------------------------------------------------- Firebase client config

# Paste from Firebase console > Project settings > Your apps > Android app, "Web API config"
# (the same values also appear in google-services.json). Leave empty to run without a Firebase
# project: the app then reports push as unavailable rather than pretending to be registered.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------- Development fixtures

# 1 serves the whole API from src/devfixtures/transport.ts, which imitates the cloud routes so a
# screen can be reviewed with no cloud host running. Requires Vite DEV mode as well - a
# production build drops the fixture module from the bundle, and `npm run verify:fixtures` fails
# if it ever appears there.
VITE_USE_FIXTURES=1
