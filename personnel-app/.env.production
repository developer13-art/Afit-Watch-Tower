# Tracked defaults for `vite build` (mode "production") — the bundle that goes into an APK.
#
# THE API ENDPOINT IS INTENTIONALLY EMPTY HERE.
#
# A release build with no endpoint compiles, boots, and refuses to sign anyone in: the login screen
# says "No server configured" and the button is disabled. That is the correct outcome for an
# un-deployed backend. The previous design fell back to a local development address instead, which
# meant a phone shipped to an officer carried the developer's laptop as its server.
#
# Supply the real endpoint at build time by ONE of these, in this order of preference:
#
#   1. .env.production.local  (gitignored; this is where a release engineer puts the host)
#        VITE_API_BASE_URL=https://<the deployed cloud host>
#   2. the environment of the build machine
#        set VITE_API_BASE_URL=https://<the deployed cloud host> && npm run build
#
# Both VITE_API_URL and VITE_API_BASE_URL are read; the first is the full base including /api/v1 and
# wins if set, the second is the origin and gets /api/v1 appended. Either way it must be HTTPS with
# a valid certificate — contract §0. `npm run verify:api-config` fails a bundle containing a
# loopback, a private LAN address or a plain-HTTP endpoint, so a mistake here is caught on the
# build machine rather than on a phone.
#
# Do not commit a real hostname into this tracked file if the deployment is not yet approved; and
# never, anywhere in this app, a database connection string, an admin credential, a Firebase
# service account, an FCM server key, a camera password or an RTSP URL.

VITE_API_URL=
VITE_API_BASE_URL=

VITE_APP_ENV=production

# The fixture transport is a dev-mode feature and cannot be enabled by a build flag alone; stating
# it as off makes the intent readable in the file that produces the release bundle.
VITE_USE_FIXTURES=0
