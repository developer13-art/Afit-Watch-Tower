# AFIT WATCH TOWER - local environment for this machine.
# Created from .env.example. Never commit this file; it is listed in .gitignore because it
# holds a database password and the key that signs every dashboard session.
#
# Two lines below still need your values, marked PASTE. Everything else is already set to a
# working first-run posture. Comments must stay on their own lines: the loader reads
# everything after "=" as the value.

# PASTE 1 - the Neon connection string, exactly as the Console prints it.
# It looks like:
#   postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Keep the "postgresql://" prefix (the short "postgres://" form is refused), keep
# "?sslmode=require" (Neon drops unencrypted connections), and percent-encode any @ # / or %
# inside the password. Leave this line empty until then and the app says so plainly.
WATCHTOWER_DATABASE_URL=postgresql://neondb_owner:npg_eZpl6WnSI1do@ep-nameless-king-b4f3nhdk-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# PASTE 2 - fill in with the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters; a boot with anything shorter is refused rather than allowed.
WATCHTOWER_JWT_SECRET=ENbgEoPkwlBGrCsQVYjALXw_RT-Zg4T0Mgaf4bPp-2QTp_7Jb85JMj3FaVwaPQ2l

# development: HTTPS enforcement is off, API docs are served at /api/docs.
WATCHTOWER_ENVIRONMENT=development

# 0 = plain http on 127.0.0.1 is reachable. Switch to 1 only when a TLS proxy sits in front,
# and switch WATCHTOWER_ENVIRONMENT to pilot/production only with AFIT's approval.
WATCHTOWER_REQUIRE_HTTPS=0

# Relative paths resolve against the folder you run from, so start every command from
# the watchtower directory. This ring is separate from the demo one at var/dev/watchtower.key:
# credentials sealed into one cannot be read by the other. Back this file up before rotating
# or reimaging - losing it means losing every camera password stored in the database.
WATCHTOWER_SECRET_KEY_PATH=./var/watchtower.key
WATCHTOWER_EVIDENCE_DIR=./var/evidence

WATCHTOWER_JWT_TTL_MINUTES=480
WATCHTOWER_EVIDENCE_RETENTION_DAYS=90
WATCHTOWER_HEALTH_RETENTION_DAYS=30
WATCHTOWER_AUDIT_RETENTION_DAYS=365

# Ingestion ceilings for a first deployment. Leave as documented and raise only after
# measuring against the real camera estate (section 7).
WATCHTOWER_MAX_CONCURRENT_STREAMS=8
WATCHTOWER_MAX_CONNECTION_TESTS=2
WATCHTOWER_STREAM_BACKOFF=2,5,15,30,60
WATCHTOWER_MAX_STREAM_RESTARTS=10

# Connection testing (section 6.5) and health thresholds (section 10).
WATCHTOWER_PROBE_TIMEOUT_SECONDS=12
WATCHTOWER_PROBE_FRAMES=12
WATCHTOWER_PROBE_SUSTAIN_SECONDS=3
WATCHTOWER_DEGRADED_AFTER_SECONDS=4
WATCHTOWER_OFFLINE_AFTER_SECONDS=15
WATCHTOWER_RECONNECTING_GRACE_SECONDS=20

# Analysis (section 11). Detections stay candidate events for a human to review.
WATCHTOWER_ANALYSIS_FPS=4
WATCHTOWER_DETECTION_MIN_CONFIDENCE=0.55
WATCHTOWER_DUPLICATE_EVENT_WINDOW=90

# Live delivery (section 9).
WATCHTOWER_LIVE_JPEG_QUALITY=78
WATCHTOWER_LIVE_MAX_MBPS=6

# No alert channel configured: the dashboard inbox is the only route, and that is a
# deliberate default rather than an oversight (section 15).
# WATCHTOWER_WEBHOOK_URL=

# --- personnel cloud API (same database, separate process) --------------
# CLOUD_JWT_SECRET signs personnel access tokens. It is not the dashboard secret and
# it is not derived from it. Rotating it signs every phone out.
CLOUD_JWT_SECRET=UBzvjZi1OgQ2usgOeRJaHQS4NbCbKOXkmihr-WcifuLf_tlMoa6plcrRmz16hYkx
# DATABASE
CLOUD_DATABASE_URL=postgresql://neondb_owner:npg_eZpl6WnSI1do@ep-nameless-king-b4f3nhdk-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require


# ENVIRONMENT
CLOUD_ENVIRONMENT=production
CLOUD_REQUIRE_HTTPS=1

# PUBLIC API
CLOUD_PUBLIC_BASE_URL=https://YOUR-CLOUD-API-DOMAIN
CLOUD_ALLOWED_ORIGINS=https://YOUR-WEB-APP-DOMAIN

# ENCRYPTION
CLOUD_SECRET_KEY_PATH=/app/secrets/cloud-token-encryption.key

# EVIDENCE STORAGE
CLOUD_EVIDENCE_DIR=/app/data/evidence

# MONITORING SERVER AUTHENTICATION
CLOUD_SERVICE_KEYS_JSON={"afit-control-room-01":"YOUR_MONITORING_SERVICE_SECRET"}

# ALERT ESCALATION
CLOUD_ESCALATE_AFTER_SECONDS=120
CLOUD_FORCED_ALERTS=YOUR_CODE_DEFINED_VALUE

# FIREBASE
CLOUD_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
CLOUD_FIREBASE_SERVICE_ACCOUNT_FILE=/app/secrets/firebase-service-account.json

# --- monitoring host -> cloud API forwarding ------------------------------
# The same pair appears twice: the cloud service validates signatures against
# CLOUD_SERVICE_KEYS_JSON, the monitoring host signs with KEY_ID/KEY_SECRET.
# Loopback http is permitted only because WATCHTOWER_ENVIRONMENT=development.
WATCHTOWER_CLOUD_API_URL=http://127.0.0.1:8080
WATCHTOWER_CLOUD_KEY_ID=host-1
WATCHTOWER_CLOUD_KEY_SECRET=pZ4iKXgl8Qzvzgg5IbVF3fmPfbnYLQyOEX1hZQY1nAZPFkuizUHpPX6Q_Y26_ydV
WATCHTOWER_SPOOL_DIR=var/spool
CLOUD_SERVICE_KEYS_JSON={"host-1":"pZ4iKXgl8Qzvzgg5IbVF3fmPfbnYLQyOEX1hZQY1nAZPFkuizUHpPX6Q_Y26_ydV"}
