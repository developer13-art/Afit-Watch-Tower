# AFIT WATCH TOWER - configuration template.
#
# Copy this file to `.env` and fill in the values marked PASTE. `.env` holds the real
# credentials and is listed in .gitignore; THIS file is committed and must stay free of them.
# Nothing below is a working secret: every credential is a placeholder, and the two that must be
# generated are generated on your own machine with the command in the comment.
#
# The application reads the process environment. `python -m watchtower.cloud --env-file <path>`
# loads a file like this one without overwriting variables the shell already set.
# Comments must stay on their own lines: the loader reads everything after "=" as the value.

# ------------------------------------------------------------------ console (monitoring host)

# PASTE 1 - the Neon connection string, exactly as the Console prints it.
# It looks like:
#   postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Keep the "postgresql://" prefix (the short "postgres://" form is refused), keep
# "?sslmode=require" (Neon drops unencrypted connections), and percent-encode any @ # / or %
# inside the password. Leave this line empty until then and the app says so plainly.
WATCHTOWER_DATABASE_URL=

# PASTE 2 - fill in with the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters; a boot with anything shorter is refused rather than allowed.
WATCHTOWER_JWT_SECRET=

# development: HTTPS enforcement is off, API docs are served at /api/docs.
WATCHTOWER_ENVIRONMENT=development

# 0 = plain http on 127.0.0.1 is reachable. Switch to 1 only when a TLS proxy sits in front,
# and switch WATCHTOWER_ENVIRONMENT to pilot/production only with AFIT's approval.
WATCHTOWER_REQUIRE_HTTPS=0

# Relative paths resolve against the folder you run from, so start every command from
# the watchtower directory. This ring is separate from the demo one at var/dev/watchtower.key:
# credentials sealed into one cannot be read by the other. Back this file up before rotating
# or reimaging - losing it means losing every camera password stored in the database.
WATCHTOWER_SECRET_KEY_PATH=./var/watchtower.key
WATCHTOWER_EVIDENCE_DIR=./var/evidence

WATCHTOWER_JWT_TTL_MINUTES=480
WATCHTOWER_EVIDENCE_RETENTION_DAYS=90
WATCHTOWER_HEALTH_RETENTION_DAYS=30
WATCHTOWER_AUDIT_RETENTION_DAYS=365

# Ingestion ceilings for a first deployment. Leave as documented and raise only after
# measuring against the real camera estate (section 7).
WATCHTOWER_MAX_CONCURRENT_STREAMS=8
WATCHTOWER_MAX_CONNECTION_TESTS=2
WATCHTOWER_STREAM_BACKOFF=2,5,15,30,60
WATCHTOWER_MAX_STREAM_RESTARTS=10

# Connection testing (section 6.5) and health thresholds (section 10).
WATCHTOWER_PROBE_TIMEOUT_SECONDS=12
WATCHTOWER_PROBE_FRAMES=12
WATCHTOWER_PROBE_SUSTAIN_SECONDS=3
WATCHTOWER_DEGRADED_AFTER_SECONDS=4
WATCHTOWER_OFFLINE_AFTER_SECONDS=15
WATCHTOWER_RECONNECTING_GRACE_SECONDS=20

# Analysis (section 11). Detections stay candidate events for a human to review.
WATCHTOWER_ANALYSIS_FPS=4
WATCHTOWER_DETECTION_MIN_CONFIDENCE=0.55
WATCHTOWER_DUPLICATE_EVENT_WINDOW=90

# Live delivery (section 9).
WATCHTOWER_LIVE_JPEG_QUALITY=78
WATCHTOWER_LIVE_MAX_MBPS=6

# No alert channel configured: the dashboard inbox is the only route, and that is a
# deliberate default rather than an oversight (section 15).
# WATCHTOWER_WEBHOOK_URL=

# ------------------------------------------------------------------ forwarding to the cloud
#
# These three turn the monitoring host into a *client* of the personnel API. Left unset, the
# incident outbox stays empty and no phone is ever paged - the console keeps working on its own,
# which is the intended posture for a host that has not been pointed at a cloud yet.
#
# The pair in WATCHTOWER_CLOUD_SERVICE_KEYS_JSON on the cloud side and these values on the host
# must match; generate both with:
#   PYTHONPATH=src python -m watchtower.cloud service-key
# It prints the one line to paste into the cloud environment and here.

# The public HTTPS origin of the cloud service, with no trailing path.
WATCHTOWER_CLOUD_API_URL=
WATCHTOWER_CLOUD_KEY_ID=
# At least 32 characters. This HMAC-signs every ingest request; it is a secret, so it lives in
# the host's own .env and never in the repository, an issue thread or a screenshot.
WATCHTOWER_CLOUD_KEY_SECRET=

# ------------------------------------------------------------------ cloud (personnel API)
#
# Read by `python -m watchtower.cloud serve --env-file <this file>`. `config-check` reports each
# one as configured, absent or wrong, so a missing value is a stated state rather than a silent
# one. See docs/mobile-api-contract.md for what the service does with them.
#
# Two of these deliberately do NOT reuse the console's values even when the deployment is on the
# same database: the cloud signs its own handset tokens with its own secret, and it holds its own
# key ring, so a leak of one ring does not open the other.
#
# The socket is not configured here. `serve` takes its address from --host (loopback unless told
# otherwise) and its port from --port, then the platform's PORT, then 8080; a hosting platform
# publishes the port it routes to, and a service that ignores it answers nobody. The worker's two
# jobs - FCM delivery and the stale-incident sweep - are selected by `worker --jobs`, not by an
# environment value, so a start command says plainly which loop it runs.

# The same Neon database as the console - one estate, one record of each incident. Copy the
# PASTE 1 value; the loader refuses a non-PostgreSQL URL here too.
CLOUD_DATABASE_URL=

# Generate separately from WATCHTOWER_JWT_SECRET:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUD_JWT_SECRET=

# development | pilot | production. Anything but development forces https and refuses a
# loopback CLOUD_PUBLIC_BASE_URL.
CLOUD_ENVIRONMENT=development

# The origin handsets are configured with, and the origin the https deep-link form is built
# from (`<this>/open/incidents/{id}`). In production this must be the public https host.
CLOUD_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Where the cloud unseals registration tokens and verifies ingest signatures. Keep it away from
# the console's WATCHTOWER_SECRET_KEY_PATH; losing this file means every stored FCM token has to
# be re-registered by each handset signing in again.
CLOUD_SECRET_KEY_PATH=./var/cloud.key

# Relay storage for evidence bytes forwarded from the monitoring host. Not a backup of the
# originals, and never a directory a camera writes into.
CLOUD_EVIDENCE_DIR=./var/cloud-evidence

# Comma-separated origins allowed to read responses. "Native app" is not an exemption: the packaged
# Android app is a WebView whose own origin is https://localhost (capacitor.config.ts sets
# androidScheme 'https'), and an unlisted origin has its preflight refused - measured 400 against a
# running service, versus 200 with the origin listed. So a phone app needs https://localhost here;
# add the web build's https origin only if you host one.
CLOUD_ALLOWED_ORIGINS=https://localhost,http://localhost

# 0 in development only. In production it must be 1 and a TLS proxy must terminate outside here.
CLOUD_REQUIRE_HTTPS=0

# Handset token lifetimes. A 15-minute access token is why the app can survive a network drop
# without re-prompting for a password: it refreshes instead.
CLOUD_ACCESS_TOKEN_TTL_SECONDS=900
CLOUD_REFRESH_TOKEN_TTL_SECONDS=2592000

# The monitoring host's machine credentials. Generate with `python -m watchtower.cloud
# service-key`, which prints the JSON form. Either that object or the single-key pair below is
# accepted, and both may be set at once - but one key id cannot carry two different secrets,
# because that means a rotation was applied to one host and not the other. A dictionary of key id
# to secret lets two monitoring hosts page independently, and one be revoked alone.
CLOUD_SERVICE_KEYS_JSON=
CLOUD_INGEST_KEY_ID=
CLOUD_INGEST_KEY_SECRET=
CLOUD_INGEST_MAX_SKEW_SECONDS=300

# How long a critical incident may stay unacknowledged before the worker escalates it to the
# next role, and what no recipient may silence. The names in CLOUD_FORCED_ALERTS are compared
# against both the severity and the alert kind.
CLOUD_ESCALATE_AFTER_SECONDS=180
CLOUD_FORCED_ALERTS=critical,incident.escalated

# How often the delivery worker polls the queue.
CLOUD_POLL_SECONDS=5

# ---------------------------------------------------------------- Live channel (contract 10.8)

# The authenticated Server-Sent-Events route GET /api/v1/events/stream that an OPEN app holds, so a
# new alert reaches the screen in about CLOUD_STREAM_POLL_SECONDS instead of up to the app's
# VITE_ALERT_POLL_SECONDS. It is a latency accelerator, not delivery to a closed phone: only
# Firebase push does that. Set to 0 to switch the route off; every client then sees
# 503 stream_disabled and falls back to its poll, and /healthz reports live_channel=disabled.
CLOUD_STREAM_ENABLED=1

# How often the stream reads the database for its subscribers. Each poll opens a SHORT-LIVED
# session, so this costs reads, not pool connections held open while the stream sleeps.
CLOUD_STREAM_POLL_SECONDS=2

# A frame with no event is written this often, so a client can tell a dead radio from a quiet
# service. The app treats three of these missing as a dropped connection.
CLOUD_STREAM_HEARTBEAT_SECONDS=15

# The service ends every connection by itself after this many seconds and the client reconnects,
# which re-runs the permission check. MUST stay below CLOUD_ACCESS_TOKEN_TTL_SECONDS - a stream
# that outlived the token that authorised it would be an authorisation nobody re-examined. The
# loader refuses a value below 60 and refuses a value at or above the token TTL.
CLOUD_STREAM_MAX_LIFETIME_SECONDS=600

# Live connections this process will hold. Each one is a task polling the same database that
# answers logins (db.build_engine opens 10 with 20 overflow), so past the cap the answer is
# 503 stream_unavailable with Retry-After 30 rather than a queue. Size it with the number of
# officers who keep the app open at once, and raise the pool if you raise this.
CLOUD_STREAM_MAX_CONNECTIONS=24

# Firebase Cloud Messaging. LEAVE BOTH EMPTY until the Firebase project exists: with nothing set
# the service reports every push as `not_configured` and keeps working, which is the honest
# posture. Setting the file without the project id - or a file path that does not exist - is a
# configuration error the service refuses to start on.
#
# The service account file is a server-side credential. It must never be placed inside
# personnel-app, in android/app/, or anywhere the Android package is built from: the app needs
# only the *public* client config (personnel-app/.env.example), and the private key stays here.
CLOUD_FIREBASE_PROJECT_ID=
CLOUD_FIREBASE_SERVICE_ACCOUNT_FILE=

# The deep-link scheme is fixed at `watchtower://` and is not configurable. It must match
# <data android:scheme="watchtower"> in personnel-app/android/app/src/main/AndroidManifest.xml;
# a handset whose manifest says otherwise will open the app but not the incident.
